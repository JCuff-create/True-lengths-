# Server-side Gemini (required for Cloud Run / production start)
GEMINI_API_KEY=

# Optional: override listen port (Cloud Run injects PORT automatically)
PORT=8080

# Client Firebase config — AI Studio apps typically read firebase-applet-config.json.
# If the app uses Vite env vars instead, mirror the applet config here:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
