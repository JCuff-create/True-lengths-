# Server-only Gemini key. Never use a VITE_ prefix for a secret.
# Local Cursor development: copy this file to .env.local and enter your key there.
# Deployed app: configure GEMINI_API_KEY in the hosting service's secure environment settings.
GEMINI_API_KEY=""
# Default follows Google's supported Flash alias; override with a model your key can access.
GEMINI_MODEL="gemini-flash-latest"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Firebase configuration overrides (defaults are loaded from firebase-applet-config.json)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""
