rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/owners/$(request.auth.uid))
        && get(/databases/$(database)/documents/owners/$(request.auth.uid)).data.status == 'active';
    }

    function isActiveStylist() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/stylists/$(request.auth.uid))
        && get(/databases/$(database)/documents/stylists/$(request.auth.uid)).data.status == 'active';
    }

    function isPendingStylist() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/stylists/$(request.auth.uid))
        && get(/databases/$(database)/documents/stylists/$(request.auth.uid)).data.status == 'pending';
    }

    function isBootstrapOwnerEmail() {
      return isSignedIn()
        && request.auth.token.email == 'carolyn.owner@truelengths.com';
    }

    function personalKeysOnly() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'status', 'salonId', 'uid', 'id']);
    }

    function immutableRoleStatusSalon() {
      return request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.salonId == resource.data.salonId;
    }

    // Prevent gaining a second role by writing another collection for the same UID
    function notInCustomers(uid) {
      return !exists(/databases/$(database)/documents/customers/$(uid));
    }
    function notInStylists(uid) {
      return !exists(/databases/$(database)/documents/stylists/$(uid));
    }
    function notInOwners(uid) {
      return !exists(/databases/$(database)/documents/owners/$(uid));
    }

    // ------------------------------------------------------------------
    // CUSTOMERS — own profile only for customers; stylists + owners may read
    // ------------------------------------------------------------------
    match /customers/{userId} {
      allow read: if isOwner()
        || isActiveStylist()
        || (isSignedIn() && request.auth.uid == userId);

      // Public signup: customer only — cannot also hold stylist/owner docs
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'customer'
        && request.resource.data.status == 'active'
        && request.resource.data.uid == userId
        && notInStylists(userId)
        && notInOwners(userId);

      allow update: if isOwner()
        || (isSignedIn()
            && request.auth.uid == userId
            && immutableRoleStatusSalon()
            && personalKeysOnly()
            && request.resource.data.role == 'customer');

      allow delete: if isOwner();
    }

    // ------------------------------------------------------------------
    // STYLISTS — never readable by customers; never writable to escalate role
    // ------------------------------------------------------------------
    match /stylists/{userId} {
      allow read: if isOwner()
        || isActiveStylist()
        || (isPendingStylist() && request.auth.uid == userId);

      // Self-create only as pending stylist after server invite validation.
      // Cannot create if customer/owner profile already exists for this UID.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'stylist'
        && request.resource.data.status == 'pending'
        && request.resource.data.uid == userId
        && notInCustomers(userId)
        && notInOwners(userId);

      // Own personal edits (cannot change role/status); owners manage status
      allow update: if isOwner()
        || (isSignedIn()
            && request.auth.uid == userId
            && immutableRoleStatusSalon()
            && personalKeysOnly()
            && request.resource.data.role == 'stylist');

      allow delete: if isOwner();
    }

    // ------------------------------------------------------------------
    // OWNERS — ONLY active owners may read/write. Stylists & customers DENIED.
    // ------------------------------------------------------------------
    match /owners/{userId} {
      allow read: if isOwner();

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isBootstrapOwnerEmail()
        && request.resource.data.role == 'owner'
        && request.resource.data.status == 'active'
        && request.resource.data.uid == userId
        && notInCustomers(userId)
        && notInStylists(userId);

      allow update: if isOwner()
        && (
          // Owners editing themselves cannot change role away from owner
          (request.auth.uid == userId
            && request.resource.data.role == 'owner'
            && personalKeysOnly())
          || (request.auth.uid != userId
            && request.resource.data.role == resource.data.role)
        );

      allow delete: if false;
    }

    // Legacy monolithic users collection — locked (use role collections)
    match /users/{userId} {
      allow read, write: if false;
    }

    match /salons/{salonId} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }

    match /staffInvites/{inviteId} {
      allow read, write: if false;
    }

    // Default deny for unknown collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
