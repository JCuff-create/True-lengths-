rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveOwner() {
      return hasUserDoc()
        && userDoc().role == 'owner'
        && userDoc().status == 'active';
    }

    function isActiveStylist() {
      return hasUserDoc()
        && userDoc().role == 'stylist'
        && userDoc().status == 'active';
    }

    function isPendingStylist() {
      return hasUserDoc()
        && userDoc().role == 'stylist'
        && userDoc().status == 'pending';
    }

    function isActiveCustomer() {
      return hasUserDoc()
        && userDoc().role == 'customer'
        && userDoc().status == 'active';
    }

    function isStaffOrOwner() {
      return isActiveOwner() || isActiveStylist();
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function selfRoleStatusSalonLocked() {
      return request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.salonId == resource.data.salonId;
    }

    function validConsumedStaffInvite() {
      let invite = getAfter(/databases/$(database)/documents/staffInvites/$(request.resource.data.inviteCode)).data;
      return request.resource.data.inviteCode is string
        && invite.inviteId == request.resource.data.inviteCode
        && invite.role == 'stylist'
        && invite.status == 'used'
        && invite.usedByUid == request.auth.uid
        && invite.email == request.auth.token.email
        && request.resource.data.email == invite.email
        && request.resource.data.salonId == invite.salonId;
    }

    function canReadPendingInvite() {
      return isSignedIn()
        && request.auth.token.email is string
        && resource.data.role == 'stylist'
        && resource.data.status == 'pending'
        && resource.data.email == request.auth.token.email;
    }

    function canConsumePendingInvite() {
      return canReadPendingInvite()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'usedByUid', 'updatedAt'])
        && request.resource.data.status == 'used'
        && request.resource.data.usedByUid == request.auth.uid;
    }

    // Customers may only cancel (or leave status unchanged) — never reassign staff fields.
    function customerAppointmentUpdateSafe() {
      return request.resource.data.customerId == resource.data.customerId
        && request.resource.data.stylistId == resource.data.stylistId
        && request.resource.data.serviceId == resource.data.serviceId
        && request.resource.data.price == resource.data.price
        && request.resource.data.date == resource.data.date
        && request.resource.data.time == resource.data.time
        && request.resource.data.status in ['upcoming', 'canceled'];
    }

    // ------------------------------------------------------------------
    // USERS — private profiles. No public access.
    // Customers: own doc only.
    // Active stylists: own + customer/stylist profiles (salon ops; never owners).
    // Owners: all profiles; only owners may change roles/statuses of others.
    // Owner documents are provisioned out-of-band (Console/Admin). No email
    // bootstrap may create or promote to owner via the client SDK.
    // ------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isActiveOwner()
        || isSelf(userId)
        || (isActiveStylist()
            && resource.data.role in ['customer', 'stylist']);

      allow create: if isSelf(userId) && (
        (request.resource.data.role == 'customer'
          && request.resource.data.status == 'active'
          && request.resource.data.uid == request.auth.uid)
        || (request.resource.data.role == 'stylist'
          && request.resource.data.status == 'pending'
          && request.resource.data.uid == request.auth.uid
          && validConsumedStaffInvite())
      );

      allow update: if isActiveOwner()
        || (isSelf(userId) && selfRoleStatusSalonLocked());

      allow delete: if isActiveOwner();
    }

    // ------------------------------------------------------------------
    // PUBLIC SALON CATALOG — read OK for browsing/booking; writes owner-only
    // ------------------------------------------------------------------
    match /services/{id} {
      allow read: if true;
      allow write: if isActiveOwner();
    }

    match /stylists/{id} {
      // Public directory for booking; stylists may update their own card
      allow read: if true;
      allow create: if isActiveOwner()
        || (isActiveStylist() && isSelf(id));
      allow update: if isActiveOwner()
        || (isActiveStylist() && isSelf(id));
      allow delete: if isActiveOwner();
    }

    match /gallery/{id} {
      allow read: if true;
      allow create, update: if isStaffOrOwner();
      allow delete: if isActiveOwner();
    }

    match /loyaltyRewards/{id} {
      allow read: if true;
      allow write: if isActiveOwner();
    }

    match /salons/{salonId} {
      allow read: if true;
      allow write: if isActiveOwner();
    }

    // ------------------------------------------------------------------
    // APPOINTMENTS — not public (contain customer PII)
    // ------------------------------------------------------------------
    match /appointments/{id} {
      allow read: if isActiveOwner()
        || isActiveStylist()
        || (isSignedIn() && resource.data.customerId == request.auth.uid);

      allow create: if isStaffOrOwner()
        || (isActiveCustomer()
            && request.resource.data.customerId == request.auth.uid);

      allow update: if isStaffOrOwner()
        || (isActiveCustomer()
            && resource.data.customerId == request.auth.uid
            && customerAppointmentUpdateSafe());

      allow delete: if isActiveOwner();
    }

    // ------------------------------------------------------------------
    // STAFF-ONLY OPERATIONS DATA
    // ------------------------------------------------------------------
    // Legacy records without salonId belong only to the original salon.
    function inventorySalon(data) {
      return data.get('salonId', 'truelengths-main');
    }

    function ownInventorySalon(data) {
      return inventorySalon(data) == userDoc().get('salonId', 'truelengths-main');
    }

    function validInventoryRestocking(data) {
      return data.stockCount is int && data.stockCount >= 0
        && (!('lowStockThreshold' in data)
          || (data.lowStockThreshold is int && data.lowStockThreshold >= 0))
        && (!('supplierName' in data) || data.supplierName is string)
        && (!('purchaseUrl' in data) || data.purchaseUrl == ''
          || (data.purchaseUrl is string
            && data.purchaseUrl.matches('https://[^/?:#@\\s]+(:[0-9]+)?([/?#][^\\s]*)?')));
    }

    match /inventory/{id} {
      allow get: if isStaffOrOwner()
        && (!exists(/databases/$(database)/documents/inventory/$(id))
          || ownInventorySalon(resource.data));
      // Explicit equality makes unscoped collection queries fail closed.
      allow list: if isStaffOrOwner()
        && resource.data.salonId == userDoc().get('salonId', 'truelengths-main');
      allow create: if isActiveOwner() && ownInventorySalon(request.resource.data)
        && validInventoryRestocking(request.resource.data);
      allow update: if isActiveOwner() && ownInventorySalon(resource.data)
        && ownInventorySalon(request.resource.data)
        && validInventoryRestocking(request.resource.data);
      allow delete: if isActiveOwner() && ownInventorySalon(resource.data);
    }

    match /formulas/{id} {
      allow read, write: if isStaffOrOwner();
    }

    // ------------------------------------------------------------------
    // GIFT CARDS — purchaser + owner; no public access to codes
    // ------------------------------------------------------------------
    match /giftCards/{id} {
      allow read: if isActiveOwner()
        || (isSignedIn() && resource.data.createdByUid == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.createdByUid == request.auth.uid;

      allow update, delete: if isActiveOwner();
    }

    // ------------------------------------------------------------------
    // NOTIFICATIONS — scoped by targetRole; owners see all
    // ------------------------------------------------------------------
    // Campaign inboxes are private. Only the server may create campaign deliveries.
    match /users/{userId}/notifications/{id} {
      allow read, delete: if isSelf(userId);
      allow update: if isSelf(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow create: if false;
    }

    match /notifications/{id} {
      allow read: if isActiveOwner()
        || (hasUserDoc()
            && (resource.data.targetRole == 'all'
                || resource.data.targetRole == userDoc().role));

      allow create: if isSignedIn();

      allow update, delete: if isActiveOwner()
        || (hasUserDoc()
            && (resource.data.targetRole == 'all'
                || resource.data.targetRole == userDoc().role));
    }

    // ------------------------------------------------------------------
    // STAFF INVITES — owners create/revoke; an invited Auth user may only get
    // and consume the exact pending invite matching their authenticated token email.
    // Invitees cannot list invitations or change protected invitation fields.
    // ------------------------------------------------------------------
    match /staffInvites/{inviteId} {
      allow get: if isActiveOwner() || canReadPendingInvite();
      allow list: if isActiveOwner();
      allow create, delete: if isActiveOwner();
      allow update: if isActiveOwner() || canConsumePendingInvite();
    }

    // Default deny — no catch-all signed-in read/write
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
