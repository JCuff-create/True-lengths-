rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveOwner() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == 'owner'
        && userDoc().status == 'active';
    }

    function isActiveStylist() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == 'stylist'
        && userDoc().status == 'active';
    }

    function isStaffOrOwner() {
      return isActiveOwner() || isActiveStylist();
    }

    // ------------------------------------------------------------------
    // USERS — auth profiles
    // ------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && request.auth.uid == userId && (
        (request.resource.data.role == 'customer' && request.resource.data.status == 'active')
        || (request.resource.data.role == 'stylist' && request.resource.data.status == 'pending')
        || (request.resource.data.role == 'owner'
            && request.auth.token.email == 'carolyn.owner@truelengths.com'
            && request.resource.data.status == 'active')
      );

      allow update: if isSignedIn() && (
        (request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && request.resource.data.salonId == resource.data.salonId)
        || isActiveOwner()
      );

      allow delete: if isActiveOwner();
    }

    // ------------------------------------------------------------------
    // Business catalogs — owner-controlled writes
    // ------------------------------------------------------------------
    match /services/{id} {
      allow read: if isSignedIn();
      allow write: if isActiveOwner();
    }

    match /stylists/{id} {
      allow read: if isSignedIn();
      allow create, update: if isActiveOwner() || (isActiveStylist() && request.auth.uid == id);
      allow delete: if isActiveOwner();
    }

    match /appointments/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isStaffOrOwner()
        || resource.data.customerId == request.auth.uid
      );
      allow delete: if isActiveOwner();
    }

    match /gallery/{id} {
      allow read: if isSignedIn();
      allow write: if isActiveOwner() || isActiveStylist();
    }

    match /inventory/{id} {
      allow read: if isStaffOrOwner();
      allow write: if isActiveOwner();
    }

    match /formulas/{id} {
      allow read: if isStaffOrOwner();
      allow write: if isStaffOrOwner();
    }

    match /loyaltyRewards/{id} {
      allow read: if isSignedIn();
      allow write: if isActiveOwner();
    }

    match /giftCards/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isActiveOwner();
    }

    match /notifications/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    match /salons/{salonId} {
      allow read: if isSignedIn();
      allow write: if isActiveOwner();
    }

    match /staffInvites/{inviteId} {
      allow read, write: if isActiveOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
