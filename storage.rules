rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Browser uploads may replace only the signed-in user's own avatar.
    // An owner uploading for a stylist is authorized on the server: Storage
    // Rules can read the default Firestore database only, and salon membership
    // lives in the named database.
    match /users/{userId}/avatar {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
