{
  "entities": {
    "customers": {
      "title": "Customers",
      "description": "Customer profiles — Firebase Auth UID as document ID",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["customer"] },
        "status": { "type": "string", "enum": ["active", "disabled"] },
        "salonId": { "type": "string" },
        "avatar": { "type": "string" },
        "hairType": { "type": "string" },
        "loyaltyPoints": { "type": "number" },
        "loyaltyTier": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "name", "role", "status", "salonId"]
    },
    "stylists": {
      "title": "Stylists",
      "description": "Stylist profiles — never readable by customers; never escalatable to owner",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["stylist"] },
        "status": { "type": "string", "enum": ["active", "pending", "disabled"] },
        "salonId": { "type": "string" },
        "avatar": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "name", "role", "status", "salonId"]
    },
    "owners": {
      "title": "Owners",
      "description": "Owner profiles — readable/writable only by active owners",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["owner"] },
        "status": { "type": "string", "enum": ["active", "disabled"] },
        "salonId": { "type": "string" },
        "avatar": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "name", "role", "status", "salonId"]
    },
    "salons": {
      "title": "Salons",
      "description": "Salon locations and organization details",
      "type": "object",
      "properties": {
        "salonId": { "type": "string" },
        "name": { "type": "string" },
        "ownerUid": { "type": "string" }
      },
      "required": ["salonId", "name", "ownerUid"]
    },
    "staffInvites": {
      "title": "Staff Invites",
      "description": "Server-managed stylist invitation metadata (hashed codes)",
      "type": "object",
      "properties": {
        "inviteId": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["stylist"] },
        "salonId": { "type": "string" },
        "createdBy": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "used", "revoked"] }
      },
      "required": ["inviteId", "email", "role", "salonId", "createdBy", "status"]
    }
  }
}
