{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --use-env-proxy --import tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node --use-env-proxy dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "test:ai": "node --import tsx --test tests/assistant.test.ts tests/assistantClient.test.ts",
    "test:inventory": "node --import tsx --test tests/inventory.test.ts",
    "test:avatar": "node --import tsx --test tests/avatarUpload.test.ts",
    "test:password-reset": "node --import tsx --test tests/passwordReset.test.ts",
    "test:availability": "node --import tsx --test tests/stylistAvailability.test.ts",
    "test:stylist-directory": "node --import tsx --test tests/stylistDirectory.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project massive-ridge-298sv \"node --import tsx tests/firestore.rules.test.mjs\"",
    "test:inventory-restock": "node --import tsx --test tests/inventoryRestock.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.17.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-tools": "^13.35.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
